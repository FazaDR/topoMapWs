<?xml version="1.0"?>
<sdf version="1.9">
  <world name="divider_room">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.85 0.90 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 12 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 12 0.05</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Four outer walls -->
    <model name="wall_left"><static>true</static><pose>-6 0 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 12 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 12 2.5</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
    </model>
    <model name="wall_right"><static>true</static><pose>6 0 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 12 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 12 2.5</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
    </model>
    <model name="wall_bottom"><static>true</static><pose>0 -6 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>12 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.2 2.5</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
    </model>
    <model name="wall_top"><static>true</static><pose>0 6 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>12 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.2 2.5</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
    </model>

    <!-- Center divider segments. The orange segment is removed by the launch file. -->
    <model name="divider_lower"><static>true</static><pose>0 -3.65 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 4.9 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.9 2.5</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="disappearing_wall"><static>true</static><pose>0 0.2 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 2.8 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 2.8 2.5</size></box></geometry><material><ambient>1 0.4 0 1</ambient><diffuse>1 0.4 0 1</diffuse></material></visual></link>
    </model>
    <model name="divider_upper"><static>true</static><pose>0 2.5 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 1.8 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 1.8 2.5</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
