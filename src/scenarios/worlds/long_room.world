<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ===================================================== -->
  <!-- Parameters (override from the command line)           -->
  <!--   xacro long_room.sdf.xacro room_length:=500          -->
  <!-- ===================================================== -->
  <xacro:arg name="room_length"    default="500.0"/>
  <xacro:arg name="room_width"     default="12.0"/>
  <xacro:arg name="wall_height"    default="6.0"/>
  <xacro:arg name="wall_thickness" default="0.2"/>
  <xacro:arg name="floor_thick"    default="0.2"/>
  <xacro:arg name="end_caps"       default="true"/>

  <xacro:property name="L"  value="$(arg room_length)"/>
  <xacro:property name="W"  value="$(arg room_width)"/>
  <xacro:property name="H"  value="$(arg wall_height)"/>
  <xacro:property name="T"  value="$(arg wall_thickness)"/>
  <xacro:property name="FT" value="$(arg floor_thick)"/>

  <!-- Static box model: name, center x y z, size x y z -->
  <xacro:macro name="static_box" params="name x y z sx sy sz">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} ${z} 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>${sx} ${sy} ${sz}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>${sx} ${sy} ${sz}</size></box></geometry>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <world name="long_room">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
      <dynamic_pose_hertz>1000</dynamic_pose_hertz>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.85 0.90 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>${L/2} 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <!-- ===================================================== -->
    <!-- Floor: top surface at z = 0                            -->
    <!-- ===================================================== -->
    <model name="floor">
      <static>true</static>
      <pose>${L/2} 0 ${-FT/2} 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>${L} ${W} ${FT}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>${L} ${W} ${FT}</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- Side walls (inside the width, like the Python script)  -->
    <!-- ===================================================== -->
    <xacro:static_box name="wall_left"  x="${L/2}" y="${W/2 - T/2}"  z="${H/2}"
                      sx="${L}" sy="${T}" sz="${H}"/>
    <xacro:static_box name="wall_right" x="${L/2}" y="${-(W/2 - T/2)}" z="${H/2}"
                      sx="${L}" sy="${T}" sz="${H}"/>

    <!-- ===================================================== -->
    <!-- End caps (set end_caps:=false for an open corridor)    -->
    <!-- ===================================================== -->
    <xacro:if value="$(arg end_caps)">
      <xacro:static_box name="wall_start" x="${T/2}"     y="0" z="${H/2}"
                        sx="${T}" sy="${W}" sz="${H}"/>
      <xacro:static_box name="wall_end"   x="${L - T/2}" y="0" z="${H/2}"
                        sx="${T}" sy="${W}" sz="${H}"/>
    </xacro:if>

  </world>
</sdf>